{
  "name": "screenshot",
  "version": "1.0.0",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "start": "node src/index.js",
    "lint": "eslint --max-warnings 0 src/ tests/",
    "test": "node --test tests/*.test.js",
    "format": "prettier --write src/ tests/",
    "format:ci": "prettier --check src/ tests/"
  },
  "author": "Tien Duc Nguyen",
  "license": "EUPL-1.2",
  "description": "Small service that extracts a sprite in SVG format from Scratch project json",
  "bin": {
    "screenshot": "src/index.js"
  },
  "dependencies": {
    "@napi-rs/canvas": "1.0.11",
    "express": "5.3.0",
    "jsdom": "30.1.2",
    "scratch-audio": "2.0.271",
    "scratch-blocks": "2.1.34",
    "scratch-render-fonts": "1.0.252",
    "scratch-vm": "5.0.300"
  },
  "bundleDependencies": [
    "@napi-rs/canvas",
    "express",
    "jsdom",
    "scratch-audio",
    "scratch-blocks",
    "scratch-vm"
  ],
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "prettier": "3.9.10"
  }
}
