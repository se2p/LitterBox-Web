{
    "name": "litterbox-web-frontend",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "license": "EUPL-1.2",
    "engines": {
        "node": ">=24 <25",
        "npm": ">=10"
    },
    "scripts": {
        "dev": "vite",
        "build": "patch-package --error-on-fail && tsc -b && vite build",
        "preview": "vite preview",
        "typecheck": "tsc -b --pretty false",
        "lint": "eslint . --max-warnings 0",
        "format": "prettier --write .",
        "format:ci": "prettier --check .",
        "budget": "node scripts/bundle-budget.mjs",
        "home-visual": "node scripts/home-visual.mjs",
        "postinstall": "patch-package",
        "test": "vitest",
        "test:ui": "playwright test"
    },
    "dependencies": {
        "@viz-js/viz": "3.31.0",
        "i18next": "26.4.4",
        "jszip": "3.10.2",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "react-i18next": "17.0.16",
        "react-router": "8.4.0",
        "scratchblocks": "3.7.1"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@playwright/test": "1.64.0",
        "@testing-library/jest-dom": "7.0.1",
        "@testing-library/react": "16.3.3",
        "@testing-library/user-event": "14.6.8",
        "@types/jsdom": "30.0.0",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@vitejs/plugin-react": "6.1.2",
        "eslint": "10.12.0",
        "eslint-plugin-react-hooks": "7.1.1",
        "eslint-plugin-react-refresh": "0.5.7",
        "globals": "17.13.0",
        "jsdom": "30.1.2",
        "patch-package": "8.0.1",
        "prettier": "3.9.10",
        "typescript": "6.0.3",
        "typescript-eslint": "8.71.2",
        "vite": "8.3.4",
        "vitest": "5.0.4"
    }
}
